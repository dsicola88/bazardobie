// BAZARR DO BIE - VENDAS ONLINE — Marketplace Angola (COD + logística local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  /// Equipa de recolha e entrega — só pedidos envio BAZAR DO BIÉ
  LOGISTICA
  VENDEDOR
  CLIENTE
}

/// Moderação de catálogo (fluxo típico de marketplace)
enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  DISMISSED
  RESOLVED
}

/// VENDEDOR = entrega pelo lojista | PLATAFORMA = entrega operada pela plataforma
enum TipoEntrega {
  VENDEDOR
  PLATAFORMA
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  EM_PREPARACAO
  EM_ENTREGA
  ENTREGUE
  CANCELADO
}

enum PaymentMethod {
  COD
  TRANSFERENCIA
  /// Reservado: PayPal / Multicaixa / outro gateway (pedido fica PENDENTE até confirmação do pagamento)
  PAGAMENTO_ONLINE
}

/// Estado do escrow por pedido (pagamento online retido até confirmação do comprador ou prazo).
enum EscrowState {
  NOT_APPLICABLE
  AWAITING_FUNDS
  HELD
  PENDING_BUYER_CONFIRM
  RELEASED
  REFUNDED
}

enum EscrowReleaseReason {
  BUYER_CONFIRMED
  AUTO_CONFIRM_TIMEOUT
  DISPUTE_FULL_REFUND
  DISPUTE_PARTIAL_SETTLEMENT
}

enum LedgerEntryKind {
  ESCROW_HOLD
  RELEASE_TO_SHOP
  REFUND_TO_BUYER
}

enum DisputeStatus {
  OPEN
  CLOSED_REJECTED
  CLOSED_FULL_REFUND
  CLOSED_PARTIAL_REFUND
}

/// Gateway electrónico (Pedidos COD/transferência usam `NAO_APLICA`).
enum GatewayPayStatus {
  NAO_APLICA
  AGUARDANDO_PAGAMENTO
  PROCESSANDO
  PAGO
  FALHOU
}

/// Configuração de textos e promoções (editável pelo admin — aparecem no site público)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  label     String?
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Contas só OAuth podem ter `null` (início de sessão apenas Google/Facebook).
  passwordHash String?
  name         String
  /// Ligação opcional à conta Google (OpenID `sub`).
  googleId     String?   @unique
  /// Ligação opcional à conta Facebook (`id` do Graph API).
  facebookId   String?   @unique
  phone        String?
  avatarUrl    String?
  role         UserRole  @default(CLIENTE)
  /// Conta suspensa (vendedor ou outro) — bloqueia API autenticada
  blocked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Quando role = LOGISTICA: parceiro externo (null = equipa interna da plataforma, vê todas as encomendas BAZAR DO BIÉ).
  logisticsPartnerId String?
  logisticsPartner   LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  shop           Shop?
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  reportsFiled   Report[]       @relation("ReportReporter")
  adminAuditLogs AdminAuditLog[]
  disputesOpened Dispute[]       @relation("DisputeOpener")
  disputesResolved Dispute[]     @relation("DisputeResolver")
}

model Shop {
  id                   String @id @default(cuid())
  userId               String @unique

  /// Nível 1 — dados mínimos para vender e receber pedidos
  name                 String
  ownerResponsibleName String
  description          String? @db.Text
  province             String
  city                 String
  phone                String
  whatsapp             String
  logoUrl              String?
  tier1CompletedAt     DateTime?

  /// Nível 2 — BI, selfie (+ foto da loja opcional) → selo VERIFICADO
  biPhotoUrl             String?
  selfiePhotoUrl         String?
  storePhotoUrl          String?
  tier2SubmittedAt       DateTime?
  tier2ApprovedAt        DateTime?
  tier2RejectedReason    String? @db.Text

  /// Nível 3 — NIF, documento empresa, dados bancários → prioridade + confiança
  nif                 String?
  companyDocUrl       String?
  bankHolderName      String?
  bankName            String?
  bankIban            String?
  tier3SubmittedAt    DateTime?
  tier3ApprovedAt     DateTime?
  tier3RejectedReason String? @db.Text

  searchRankBoost Int @default(0)

  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  orderItems     OrderItem[]
  reports        Report[]
  ledgerEntries  LedgerEntry[]

  @@index([isApproved])
  @@index([tier2SubmittedAt])
  @@index([tier3SubmittedAt])
  @@index([searchRankBoost])
}

model Banner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String    @id @default(cuid())
  shopId      String
  categoryId  String?
  name        String
  description String    @db.Text
  sku         String
  price        Decimal   @db.Decimal(12, 2)
  promoPrice   Decimal?  @db.Decimal(12, 2)
  displayPrice Decimal   @db.Decimal(12, 2)
  stock        Int       @default(0)
  isFeatured  Boolean   @default(false)
  /// Novos produtos entram em revisão até aprovação do admin
  moderationStatus ProductModerationStatus @default(APPROVED)
  isActive    Boolean   @default(true)
  soldCount     Int       @default(0)
  reviewCount   Int       @default(0)
  averageRating Decimal?  @db.Decimal(3, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop             Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  deliveryOptions  ProductDeliveryOption[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  favorites        Favorite[]
  reports          Report[]

  @@unique([shopId, sku])
  @@index([categoryId])
  @@index([isFeatured, isActive])
  @@index([shopId])
  @@index([moderationStatus])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String
  name        String?
  color       String?
  size        String?
  priceAdjust Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@unique([productId, sku])
  @@index([productId])
}

/// Opções de envio configuráveis por produto (obrigatório na criação de produto pelo vendedor)
model ProductDeliveryOption {
  id              String       @id @default(cuid())
  productId       String
  tipoEntrega     TipoEntrega
  custoEntrega    Decimal      @db.Decimal(12, 2)
  prazoEstimado   Int
  areaProvincia   String
  areaCidade      String
  /// Operador de última milha (lista definida pela administração). Só faz sentido com envio pela plataforma.
  logisticsPartnerId String?
  logisticsPartner    LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
  @@index([logisticsPartnerId])
}

model Cart {
  id        String    @id @default(cuid())
  userId    String?   @unique
  sessionId String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id                      String @id @default(cuid())
  cartId                  String
  productId               String
  variantId               String?
  productDeliveryOptionId String
  quantity                Int

  cart                   Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product                Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant                ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productDeliveryOption ProductDeliveryOption @relation(fields: [productDeliveryOptionId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([cartId, productId])
}

model Order {
  id               String        @id @default(cuid())
  checkoutGroupId  String?
  userId           String
  status           OrderStatus   @default(PENDENTE)
  paymentMethod    PaymentMethod
  paymentProofUrl  String?
  shippingName     String
  shippingPhone    String
  shippingProvince String
  shippingCity     String
  shippingAddress  String        @db.Text
  notes            String?       @db.Text
  subtotal         Decimal       @db.Decimal(12, 2)
  deliveryTotal    Decimal       @db.Decimal(12, 2)
  grandTotal       Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  gatewayPayStatus  GatewayPayStatus @default(NAO_APLICA)
  /// Ex.: MOCK, PAYPAL, MULTICAIXA
  gatewayProvider   String?
  /// Id de sessão ou intent no gateway / mock
  gatewayExternalId String?

  escrowState EscrowState @default(NOT_APPLICABLE)
  /// Quando o vendedor marcou ENTREGUE (logística).
  deliveredAt DateTime?
  /// Comprador confirmou explicitamente «recebi».
  buyerConfirmedAt DateTime?
  /// Após esta data/time, liberta automaticamente ao vendedor se não houver disputa.
  escrowAutoConfirmAt DateTime?
  escrowReleasedAt DateTime?
  escrowReleaseReason EscrowReleaseReason?

  /// Código de rastreio (transportadora / última milha).
  trackingCode    String?
  /// Nome da transportadora ou serviço (ex.: DHL, Moto taxi interno).
  trackingCarrier String?
  /// Página pública de seguimento (https…).
  trackingUrl     String?

  user    User      @relation(fields: [userId], references: [id])
  items   OrderItem[]
  reviews Review[]
  ledgerEntries LedgerEntry[]
  disputes  Dispute[]

  /// Parceiro de logística responsável (envio PLATAFORMA). Null = equipa interna ou ainda por atribuir.
  logisticsPartnerId String?
  logisticsPartner   LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status])
  @@index([checkoutGroupId])
  @@index([logisticsPartnerId])
}

model OrderItem {
  id                  String        @id @default(cuid())
  orderId             String
  shopId              String
  productId           String
  variantId           String?
  quantity            Int
  unitPrice           Decimal       @db.Decimal(12, 2)
  deliveryCost        Decimal       @db.Decimal(12, 2)
  productNameSnapshot String
  variantNameSnapshot String?
  deliveryTipo        TipoEntrega
  deliveryDays        Int
  areaProvincia       String
  areaCidade          String

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop    Shop            @relation(fields: [shopId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([shopId])
}

model LedgerEntry {
  id        String          @id @default(cuid())
  orderId   String
  shopId    String
  kind      LedgerEntryKind
  amount    Decimal         @db.Decimal(12, 2)
  note      String?
  createdAt DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shopId])
}

model Dispute {
  id               String          @id @default(cuid())
  orderId          String
  openedByUserId   String
  reason           String          @db.Text
  status           DisputeStatus   @default(OPEN)
  refundAmount     Decimal?        @db.Decimal(12, 2)
  resolutionNote   String?         @db.Text
  resolvedAt       DateTime?
  resolverAdminId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  opener   User  @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Cascade)
  resolver User? @relation("DisputeResolver", fields: [resolverAdminId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String
  rating    Int
  comment   String?  @db.Text
  /// URLs de fotos (ex.: uploads da plataforma), máximo sugerido 6 na API
  photoUrls String[] @default([])
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

enum NotificationType {
  PEDIDO
  LOJA
  GERAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GERAL)
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

/// Denúncias de loja ou produto (confiança / moderação)
model Report {
  id         String        @id @default(cuid())
  reporterId String
  shopId     String?
  productId  String?
  message    String        @db.Text
  status     ReportStatus  @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  reporter User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  shop     Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([shopId])
  @@index([productId])
}

/// Registo de acessos a rotas /admin (JWT + role já validados antes deste hook)
model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  method    String
  path      String
  ip        String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

/// Transportadora ou parceiro de última milha contratado (cadastro pelo admin).
model LogisticsPartner {
  id          String   @id @default(cuid())
  name        String
  nif         String?
  phone       String?
  email       String?
  contactName String?
  province    String?
  city        String?
  notes       String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff                   User[]
  orders                  Order[]
  productDeliveryOptions  ProductDeliveryOption[]

  @@index([active])
}
