// BAZARR DO BIE - VENDAS ONLINE — Marketplace Angola (COD + logística local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis da plataforma (modelo tipo marketplaces: cliente compra, vendedor vende, suporte modera, logística entrega, admin controla tudo).
/// Nomenclatura API/BD em PT; equivalentes: CLIENTE=CUSTOMER, VENDEDOR=SELLER, SUPORTE=SUPPORT, LOGISTICA=LOGISTICS.
enum UserRole {
  ADMIN
  /// Assistência: aprova lojas/produtos, vê encomendas e chats, disputas (sem reembolso), estados e rastreio — sem finanças, sem equipa crítica.
  SUPORTE
  /// Equipa de recolha e entrega — só pedidos envio BAZAR DO BIÉ
  LOGISTICA
  VENDEDOR
  CLIENTE
}

/// Moderação de catálogo (fluxo típico de marketplace)
enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Condição comercial do artigo (estilo marketplaces como eBay).
enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
}

enum ReportStatus {
  OPEN
  DISMISSED
  RESOLVED
}

/// VENDEDOR = entrega pelo lojista | PLATAFORMA = entrega operada pela plataforma
enum TipoEntrega {
  VENDEDOR
  PLATAFORMA
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  EM_PREPARACAO
  EM_ENTREGA
  ENTREGUE
  CANCELADO
}

enum PaymentMethod {
  COD
  TRANSFERENCIA
  /// Reservado: PayPal / Multicaixa / outro gateway (pedido fica PENDENTE até confirmação do pagamento)
  PAGAMENTO_ONLINE
}

/// Estado do escrow por pedido (pagamento online retido até confirmação do comprador ou prazo).
enum EscrowState {
  NOT_APPLICABLE
  AWAITING_FUNDS
  HELD
  PENDING_BUYER_CONFIRM
  RELEASED
  REFUNDED
}

enum EscrowReleaseReason {
  BUYER_CONFIRMED
  AUTO_CONFIRM_TIMEOUT
  DISPUTE_FULL_REFUND
  DISPUTE_PARTIAL_SETTLEMENT
}

enum LedgerEntryKind {
  ESCROW_HOLD
  RELEASE_TO_SHOP
  REFUND_TO_BUYER
}

enum DisputeStatus {
  OPEN
  CLOSED_REJECTED
  CLOSED_FULL_REFUND
  CLOSED_PARTIAL_REFUND
}

/// Gateway electrónico (Pedidos COD/transferência usam `NAO_APLICA`).
enum GatewayPayStatus {
  NAO_APLICA
  AGUARDANDO_PAGAMENTO
  PROCESSANDO
  PAGO
  FALHOU
}

/// Configuração de textos e promoções (editável pelo admin — aparecem no site público)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  label     String?
  updatedAt DateTime @updatedAt
}

/// Divisões administrativas de Angola — fonte estrutural para checkout e fretes (sem depender do texto livre).
model AngolaProvince {
  id        String   @id @default(cuid())
  /// Código estável para integrações (ex.: LUA, BIE).
  code      String   @unique
  namePt    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipalities AngolaMunicipality[]

  @@index([active, sortOrder])
}

/// Município conforme subdivisão angolana — unidade onde se fixa zona de envio ou ponto de recolha.
model AngolaMunicipality {
  id         String @id @default(cuid())
  provinceId String
  /// Slug estável dentro da província (ex.: TALATONA).
  code       String
  namePt     String
  latitude   Decimal? @db.Decimal(11, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province AngolaProvince @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  shippingZones   ShippingZone[]
  freightAnchors FreightLocality[]
  pickupPoints    DeliveryPickupPoint[]
  communes        AngolaCommune[]
  orders          Order[]
  shops           Shop[]
  users           User[]

  @@unique([provinceId, code])
  @@index([provinceId, active, sortOrder])
}

/// Comuna dentro do municipio (estrutura administrativa complementar para UX e filtros).
model AngolaCommune {
  id             String @id @default(cuid())
  municipalityId String
  /// Codigo estavel dentro do municipio (ex.: SEDE, BENFICA, etc.)
  code           String
  namePt         String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality AngolaMunicipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  @@unique([municipalityId, code])
  @@index([municipalityId, active, sortOrder])
}

/// Ponto estruturado de entrega/recolha (locker ou loja associada — escalável tipo marketplace AliExpress pickup).
model DeliveryPickupPoint {
  id             String             @id @default(cuid())
  municipalityId String
  municipality   AngolaMunicipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  /// Nome público para o comprador seleccionar.
  namePt         String
  /// Código opcional para operação na origem/gate (não equivale ao endereço livre da rua).
  refCode        String?
  latitude       Decimal @db.Decimal(11, 8)
  longitude      Decimal @db.Decimal(11, 8)
  sortOrder      Int     @default(0)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@index([municipalityId, active])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Contas só OAuth podem ter `null` (início de sessão apenas Google/Facebook).
  passwordHash String?
  name         String
  /// Ligação opcional à conta Google (OpenID `sub`).
  googleId     String?   @unique
  /// Ligação opcional à conta Facebook (`id` do Graph API).
  facebookId   String?   @unique
  phone        String?
  /// Endereço estrutural principal do comprador (base para cálculo de frete).
  municipalityId String?
  municipality   AngolaMunicipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  /// Espelhos legíveis para relatórios e snapshots rápidos.
  province     String?
  city         String?
  neighborhood String?
  addressLine  String?
  avatarUrl    String?
  role         UserRole  @default(CLIENTE)
  /// Conta suspensa (vendedor ou outro) — bloqueia API autenticada
  blocked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Quando role = LOGISTICA: parceiro externo (null = equipa interna da plataforma, vê todas as encomendas BAZAR DO BIÉ).
  logisticsPartnerId String?
  logisticsPartner   LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  shop           Shop?
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  /// Rasto de produtos vistos (chave `u:{userId}` em `ProductRecentView.identityKey`)
  recentProductViews ProductRecentView[]
  notifications  Notification[]
  reportsFiled   Report[]       @relation("ReportReporter")
  adminAuditLogs AdminAuditLog[]
  disputesOpened Dispute[]       @relation("DisputeOpener")
  disputesResolved Dispute[]     @relation("DisputeResolver")
  chatMessagesSent OrderChatMessage[]
  passwordResetTokens PasswordResetToken[]

  @@index([municipalityId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Shop {
  id                   String @id @default(cuid())
  userId               String @unique

  /// Nível 1 — dados mínimos para vender e receber pedidos
  name                 String
  ownerResponsibleName String
  description          String? @db.Text
  /// Município oficial (catálogo ANG — alinhamento com fretes/checkout).
  municipalityId String?
  municipality   AngolaMunicipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  /// Espelhos legível da província e município (servidor preenche a partir de municipalityId quando definido).
  province             String
  city                 String
  phone                String
  whatsapp             String
  logoUrl              String?
  tier1CompletedAt     DateTime?

  /// Nível 2 — BI, selfie (+ foto da loja opcional) → selo VERIFICADO
  biPhotoUrl             String?
  selfiePhotoUrl         String?
  storePhotoUrl          String?
  tier2SubmittedAt       DateTime?
  tier2ApprovedAt        DateTime?
  tier2RejectedReason    String? @db.Text

  /// Nível 3 — NIF, documento empresa, dados bancários → prioridade + confiança
  nif                 String?
  companyDocUrl       String?
  bankHolderName      String?
  bankName            String?
  bankIban            String?
  tier3SubmittedAt    DateTime?
  tier3ApprovedAt     DateTime?
  tier3RejectedReason String? @db.Text

  searchRankBoost Int @default(0)

  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Ponto de origem para cálculo de frete por distância (envio pela loja). Opcional — use coordenadas WGS‑84 decimais.
  freightOriginLatitude  Decimal? @db.Decimal(11, 8)
  freightOriginLongitude Decimal? @db.Decimal(11, 8)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  orderItems     OrderItem[]
  reports        Report[]
  ledgerEntries  LedgerEntry[]

  @@index([isApproved])
  @@index([tier2SubmittedAt])
  @@index([tier3SubmittedAt])
  @@index([searchRankBoost])
  @@index([municipalityId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String    @id @default(cuid())
  shopId      String
  categoryId  String?
  name        String
  description String    @db.Text
  /// Video curto opcional de demonstracao do produto (max. 60s recomendado).
  demoVideoUrl String?
  sku         String
  price        Decimal   @db.Decimal(12, 2)
  promoPrice   Decimal?  @db.Decimal(12, 2)
  displayPrice Decimal   @db.Decimal(12, 2)
  condition    ProductCondition @default(NEW)
  /// Observações do vendedor sobre estado de uso (ex.: tempo de uso, sinais, itens trocados).
  conditionDetail String? @db.Text
  stock        Int       @default(0)
  isFeatured  Boolean   @default(false)
  /// Novos produtos entram em revisão até aprovação do admin
  moderationStatus ProductModerationStatus @default(APPROVED)
  isActive    Boolean   @default(true)
  soldCount     Int       @default(0)
  reviewCount   Int       @default(0)
  averageRating Decimal?  @db.Decimal(3, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop             Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  deliveryOptions  ProductDeliveryOption[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  favorites        Favorite[]
  reports          Report[]
  homeGroupMembers HomeProductGroupMember[]
  recentViews      ProductRecentView[]

  @@unique([shopId, sku])
  @@index([categoryId])
  @@index([isFeatured, isActive])
  @@index([shopId])
  @@index([moderationStatus])
}

/// Layout da secção na página inicial.
enum HomeGroupLayoutStyle {
  GRID
  /// Carrossel compacto estilo marketplace (cartões com preço, desconto, avaliação).
  SHOWCASE
}

/// Badge opcional acima do carrossel (texto fixo ou contagem regressiva).
enum HomeGroupBadgeType {
  NONE
  TEXT
  TIMER
}

/// O que destacar nos mini-cartões do modo SHOWCASE.
enum HomeGroupCardEmphasis {
  BALANCED
  DISCOUNT
  RATING
}

/// Secções curadas na página inicial (ex.: Super ofertas, Produtos em desconto).
model HomeProductGroup {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  /// Máximo de artigos a mostrar na vitrine pública.
  maxDisplay  Int      @default(12)
  /// Grelha clássica ou vitrine com carrossel.
  layoutStyle HomeGroupLayoutStyle @default(GRID)
  badgeType   HomeGroupBadgeType @default(NONE)
  /// Texto da pastilha (ex.: «3 artigos a partir de…») quando badgeType = TEXT.
  badgeText   String?
  /// Data-limite ISO para contagem quando badgeType = TIMER.
  badgeEndAt  DateTime?
  /// Rótulo do botão «Ver mais» (opcional).
  ctaLabel    String?
  /// Destino: caminho interno (/search?…) ou URL absoluta.
  ctaHref     String?
  /// Destaque visual nos cartões (desconto vs avaliações).
  productCardEmphasis HomeGroupCardEmphasis @default(BALANCED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members HomeProductGroupMember[]

  @@index([active, sortOrder])
}

model HomeProductGroupMember {
  id        String @id @default(cuid())
  groupId   String
  productId String
  sortOrder Int    @default(0)

  group   HomeProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([groupId, productId])
  @@index([groupId, sortOrder])
}

/// Layout de vitrine só com imagens e links (marketing, estilo marketplace).
enum HomeSpotlightLayout {
  GRID_2X2
  HERO_THREE
  ROW_SCROLL
}

model HomeSpotlightSection {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  subtitle    String?
  layout      HomeSpotlightLayout @default(GRID_2X2)
  sortOrder   Int                 @default(0)
  active      Boolean             @default(true)
  /// Cor de fundo opcional dos cartões (hex ou CSS curto).
  cardAccent  String?
  ctaLabel    String?
  ctaHref     String?
  /// Limite de cartões expostos na API pública (1–24).
  maxTiles    Int                 @default(12)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tiles HomeSpotlightTile[]

  @@index([active, sortOrder])
}

model HomeSpotlightTile {
  id        String @id @default(cuid())
  sectionId String
  sortOrder Int    @default(0)
  imageUrl  String
  label     String?
  href      String
  /// Faixa inferior opcional por cartão (hex / rgba).
  captionBg String?

  section HomeSpotlightSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String
  name        String?
  color       String?
  size        String?
  /// Preço final desta variante (estilo AliExpress). Se preenchido, substitui preço base + ajuste.
  salePrice   Decimal? @db.Decimal(12, 2)
  /// Legado: soma ao preço efectivo da ficha (promo ou preço normal) quando `salePrice` está vazio.
  priceAdjust Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@unique([productId, sku])
  @@index([productId])
}

/// Opções de envio configuráveis por produto (obrigatório na criação de produto pelo vendedor)
model ProductDeliveryOption {
  id              String       @id @default(cuid())
  productId       String
  tipoEntrega     TipoEntrega
  custoEntrega    Decimal      @db.Decimal(12, 2)
  prazoEstimado   Int
  areaProvincia   String
  areaCidade      String
  /// Operador de última milha (lista definida pela administração). Só faz sentido com envio pela plataforma.
  logisticsPartnerId String?
  logisticsPartner    LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
  @@index([logisticsPartnerId])
}

model Cart {
  id        String    @id @default(cuid())
  userId    String?   @unique
  sessionId String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id                      String @id @default(cuid())
  cartId                  String
  productId               String
  variantId               String?
  productDeliveryOptionId String
  quantity                Int

  cart                   Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product                Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant                ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productDeliveryOption ProductDeliveryOption @relation(fields: [productDeliveryOptionId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([cartId, productId])
}

model Order {
  id               String        @id @default(cuid())
  /// Código público de encomenda (gerado no backend; vendedor só consulta).
  orderCode        String?       @unique
  checkoutGroupId  String?
  userId           String
  status           OrderStatus   @default(PENDENTE)
  paymentMethod    PaymentMethod
  paymentProofUrl  String?
  shippingName     String
  shippingPhone    String

  /// Destino estrutural (obrigatório em novos checkouts quando o catágeo está configurado).
  shippingMunicipalityId String?
  shippingMunicipality   AngolaMunicipality? @relation(fields: [shippingMunicipalityId], references: [id], onDelete: SetNull)
  /// Ponto fixo opcional dentro do município (prioridade tipo pickup point marketplace).
  shippingPickupPointId  String?
  shippingPickupPoint    DeliveryPickupPoint? @relation(fields: [shippingPickupPointId], references: [id], onDelete: SetNull)

  shippingProvince String
  shippingCity     String
  /// Bairro / referência complementar opcional — não substitui o município catalogado.
  shippingNeighborhood String?
  /// Instruções curtas opcionais (andar, porta, contacto à chegada). Morada estrutural = município + ponto opcional.
  shippingAddress  String?       @db.Text
  notes            String?       @db.Text
  subtotal         Decimal       @db.Decimal(12, 2)
  deliveryTotal    Decimal       @db.Decimal(12, 2)
  grandTotal       Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  gatewayPayStatus  GatewayPayStatus @default(NAO_APLICA)
  /// Ex.: MOCK, PAYPAL, MULTICAIXA
  gatewayProvider   String?
  /// Id de sessão ou intent no gateway / mock
  gatewayExternalId String?

  escrowState EscrowState @default(NOT_APPLICABLE)
  /// Quando o vendedor marcou ENTREGUE (logística).
  deliveredAt DateTime?
  /// Comprador confirmou explicitamente «recebi».
  buyerConfirmedAt DateTime?
  /// Após esta data/time, liberta automaticamente ao vendedor se não houver disputa.
  escrowAutoConfirmAt DateTime?
  escrowReleasedAt DateTime?
  escrowReleaseReason EscrowReleaseReason?

  /// Código de rastreio (transportadora / última milha).
  trackingCode    String?
  /// Nome da transportadora ou serviço (ex.: DHL, Moto taxi interno).
  trackingCarrier String?
  /// Página pública de seguimento (https…).
  trackingUrl     String?

  user    User      @relation(fields: [userId], references: [id])
  items   OrderItem[]
  reviews Review[]
  ledgerEntries LedgerEntry[]
  disputes  Dispute[]
  chatMessages OrderChatMessage[]

  /// Parceiro de logística responsável (envio PLATAFORMA). Null = equipa interna ou ainda por atribuir.
  logisticsPartnerId String?
  logisticsPartner   LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)

  /// Distância (km haversine) origem→destino e faixa aplicada quando o modo frete por distância está activo.
  freightComputedDistanceKm Decimal?               @db.Decimal(12, 3)
  freightDistanceBandId     String?
  freightDistanceBand       ShippingDistanceBand?  @relation(fields: [freightDistanceBandId], references: [id], onDelete: SetNull)

  /// Tarifa aplicada quando o modo «frete por zona (morada)» está activo.
  freightShippingZoneId String?
  freightShippingZone   ShippingZone? @relation(fields: [freightShippingZoneId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status])
  @@index([checkoutGroupId])
  @@index([logisticsPartnerId])
  @@index([shippingMunicipalityId])
}

model OrderChatMessage {
  id        String          @id @default(cuid())
  orderId   String
  senderId  String
  type      ChatMessageType @default(TEXT)
  text      String?         @db.Text
  mediaUrl  String?
  createdAt DateTime        @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([senderId, createdAt])
}

model OrderItem {
  id                  String        @id @default(cuid())
  orderId             String
  shopId              String
  productId           String
  variantId           String?
  quantity            Int
  unitPrice           Decimal       @db.Decimal(12, 2)
  deliveryCost        Decimal       @db.Decimal(12, 2)
  productNameSnapshot String
  variantNameSnapshot String?
  deliveryTipo        TipoEntrega
  deliveryDays        Int
  areaProvincia       String
  areaCidade          String

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop    Shop            @relation(fields: [shopId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([shopId])
}

model LedgerEntry {
  id        String          @id @default(cuid())
  orderId   String
  shopId    String
  kind      LedgerEntryKind
  amount    Decimal         @db.Decimal(12, 2)
  note      String?
  createdAt DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shopId])
}

model Dispute {
  id               String          @id @default(cuid())
  orderId          String
  openedByUserId   String
  reason           String          @db.Text
  status           DisputeStatus   @default(OPEN)
  refundAmount     Decimal?        @db.Decimal(12, 2)
  resolutionNote   String?         @db.Text
  resolvedAt       DateTime?
  resolverAdminId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  opener   User  @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Cascade)
  resolver User? @relation("DisputeResolver", fields: [resolverAdminId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String
  rating    Int
  comment   String?  @db.Text
  /// URLs de fotos (ex.: uploads da plataforma), máximo sugerido 6 na API
  photoUrls String[] @default([])
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

/// Histórico de vistas por utilizador autenticado (`u:{cuid}`) ou visitante (`s:{cart_session}`).
model ProductRecentView {
  id          String   @id @default(cuid())
  identityKey String
  productId   String
  viewedAt    DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([identityKey, productId])
  @@index([identityKey, viewedAt])
  @@index([userId, viewedAt])
}

enum NotificationType {
  PEDIDO
  LOJA
  GERAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GERAL)
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

/// Denúncias de loja ou produto (confiança / moderação)
model Report {
  id         String        @id @default(cuid())
  reporterId String
  shopId     String?
  productId  String?
  message    String        @db.Text
  status     ReportStatus  @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  reporter User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  shop     Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([shopId])
  @@index([productId])
}

/// Registo de acessos a rotas /admin (JWT + role já validados antes deste hook)
model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  method    String
  path      String
  ip        String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

/// Transportadora ou parceiro de última milha contratado (cadastro pelo admin).
model LogisticsPartner {
  id          String   @id @default(cuid())
  name        String
  nif         String?
  phone       String?
  email       String?
  contactName String?
  province    String?
  city        String?
  notes       String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff                   User[]
  orders                  Order[]
  productDeliveryOptions  ProductDeliveryOption[]

  @@index([active])
}

/// Faixa tarifária por distância (km entre origem definida pela loja/plataforma e localidade de entrega).
model ShippingDistanceBand {
  id            String   @id @default(cuid())
  name          String
  /// Inclusive: distância (km haversine) >= este valor.
  minDistanceKm Decimal  @db.Decimal(12, 3)
  /// Exclusive: distância < este valor (na última faixa use número alto, ex. 9999).
  maxDistanceKm Decimal  @db.Decimal(12, 3)
  price         Decimal  @db.Decimal(12, 2)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([active, sortOrder])
}

/// Tarifa plana por município de destino (lookup por ID — evita erros de digitação).
model ShippingZone {
  id        String   @id @default(cuid())
  /// Origem estrutural do preço; quando preenchido, substitui o casamento por texto em `province`/`city`.
  municipalityId String?              @unique
  municipality   AngolaMunicipality?  @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  /// Campos legados espelhados para listagens e migração a partir de dados antigos.
  province  String
  city      String
  label     String?
  price     Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([province, city])
  @@index([active, sortOrder])
  @@index([municipalityId])
}

/// Centro de referência GPS para o destino (modo distância) — amarrado preferencialmente a um município.
model FreightLocality {
  id        String   @id @default(cuid())
  label     String
  province  String
  city      String
  municipalityId String?              @unique
  municipality   AngolaMunicipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  latitude  Decimal  @db.Decimal(11, 8)
  longitude Decimal  @db.Decimal(11, 8)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([province, city])
  @@index([province, active])
  @@index([municipalityId])
}
