# --- Produção (exemplo bazardobie.com — API em api.* , site em apex ou www)
# PUBLIC_BASE_URL="https://api.bazardobie.com"
# FRONTEND_URL="https://bazardobie.com"

# --- OAuth (opcional) — login «Continuar com Google/Facebook»
# Redireccionamento autorizado nas consolas dos developers:
#   Google:   http://localhost:4000/api/v1/auth/oauth/google/callback
#   Facebook: http://localhost:4000/api/v1/auth/oauth/facebook/callback
# Em produção com api.bazardobie.com:
#   https://api.bazardobie.com/api/v1/auth/oauth/google/callback
#   https://api.bazardobie.com/api/v1/auth/oauth/facebook/callback
# PUBLIC_BASE_URL deve coincidir com o URL da API que essas apps chamam.
#GOOGLE_CLIENT_ID=""
#GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI (opcional) para forçar exactamente o callback usado no Google Console.
# Ex.: https://api.bazardobie.com/api/v1/auth/oauth/google/callback
#GOOGLE_REDIRECT_URI=""
#FACEBOOK_APP_ID=""
#FACEBOOK_APP_SECRET=""
#FACEBOOK_REDIRECT_URI=""

# --- Recuperação de senha por e-mail (SMTP)
# Exemplo Gmail Workspace/App Password:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="no-reply@seudominio.com"
# SMTP_PASS="senha-app-ou-senha-smtp"
# SMTP_FROM="no-reply@seudominio.com"
# SMTP_FROM_NAME="BAZAR DO BIÉ"
# Em provedores como Brevo, SendGrid, Mailgun use os dados SMTP fornecidos no painel.