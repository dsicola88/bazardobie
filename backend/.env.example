# Base de dados (copie para backend/.env e ajuste)
# Com Docker (docker compose up -d na raiz do projeto):
DATABASE_URL="postgresql://postgres:hcGxhHPNGrTmYzdSfGQYmUPFSoFroKHQ@trolley.proxy.rlwy.net:33289/railway"
# Sem Docker — exemplo genérico:
# DATABASE_URL="postgresql://user:password@localhost:5432/bazarr_do_bie?schema=public"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"
PORT=4000
UPLOAD_DIR="./uploads"
# Produção na Railway com volume em /app/uploads: defina para silênciar o aviso de disco efémero no arranque.
# UPLOAD_VOLUME_MOUNTED="true"

# --- Cloudflare R2 (recomendado em produção — sobrevive a deploys sem volume no contentor)
# Sem estas variáveis ou com R2_UPLOADS_ENABLED=false → uploads ficam só no disco (UPLOAD_DIR no Railway).
# R2_UPLOADS_ENABLED="false"
# Conta → R2 → Overview: Account ID. Crie um token API com permissão Object Read & Write no balde.
# No balde: ligue "Acesso público R2.dev" ou um domínio personalizado; copie o URL público base (sem / no fim).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="bazardobie-imagens"
# R2_PUBLIC_BASE_URL="https://pub-xxxxxxxxxxxx.r2.dev"

PUBLIC_BASE_URL="http://localhost:4000"
# Web (Vite) — usado no redirect após /payments/mock/callback
FRONTEND_URL="http://localhost:5173"

# --- Produção (exemplo bazardobie.com — API em api.* , site em apex ou www)
# PUBLIC_BASE_URL="https://api.bazardobie.com"
# FRONTEND_URL="https://bazardobie.com"

# --- OAuth (opcional) — login «Continuar com Google/Facebook»
# Redireccionamento autorizado nas consolas dos developers:
#   Google:   http://localhost:4000/api/v1/auth/oauth/google/callback
#   Facebook: http://localhost:4000/api/v1/auth/oauth/facebook/callback
# Em produção com api.bazardobie.com:
#   https://api.bazardobie.com/api/v1/auth/oauth/google/callback
#   https://api.bazardobie.com/api/v1/auth/oauth/facebook/callback
# PUBLIC_BASE_URL deve coincidir com o URL da API que essas apps chamam.
#GOOGLE_CLIENT_ID=""
#GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI (opcional) para forçar exactamente o callback usado no Google Console.
# Ex.: https://api.bazardobie.com/api/v1/auth/oauth/google/callback
#GOOGLE_REDIRECT_URI=""
#FACEBOOK_APP_ID=""
#FACEBOOK_APP_SECRET=""
#FACEBOOK_REDIRECT_URI=""

# --- Recuperação de senha por e-mail (SMTP)
# Exemplo Gmail Workspace/App Password:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="no-reply@seudominio.com"
# SMTP_PASS="senha-app-ou-senha-smtp"
# SMTP_FROM="no-reply@seudominio.com"
# SMTP_FROM_NAME="BAZAR DO BIÉ"
# Em provedores como Brevo, SendGrid, Mailgun use os dados SMTP fornecidos no painel.

# --- API Resend (recomendado: fiável, barato, alta deliverability — https://resend.com )
# Sem custo de servidor SMTP; verifique o domínio ou use o remetente de testes no painel.
# RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM_EMAIL="onboarding@resend.dev"
# Opcional: desactivar processamento inline na API e usar só cron → npm run email-queue-once
# ENABLE_EMAIL_QUEUE_PROCESSOR="false"