# Copie para `.env.local` em desenvolvimento (opcional).
# Na Vercel: Project → Settings → Environment Variables → Production (e Preview se quiseres).

# --- Desenvolvimento (proxy Vite → backend local)
VITE_API_BASE=/api/v1

# --- Produção na Vercel + API na Railway (escolha UM dos modos)
# (A) URL completa da API — resolve também `/uploads/...` correctamente
# VITE_API_BASE=https://SEU-SERVICO.up.railway.app/api/v1
#
# (B) VITE_API_BASE relativo (/api/v1) com proxy — então defina a origem onde estão os ficheiros /uploads:
# VITE_MEDIA_ORIGIN=https://SEU-SERVICO.up.railway.app
# ou sinónimo:
# VITE_API_ORIGIN=https://SEU-SERVICO.up.railway.app
#
# Sem (A) ou (B), caminhos /uploads/... apontam para o domínio da Vercel e as imagens não carregam.
